# gen-engine Environment Configuration (.env.example)
# ===================================================
# Copy to .env and fill in with actual values
# DO NOT commit .env to git

# Service URLs
OLLAMA_URL=http://localhost:11434
TTS_URL=http://localhost:8880
KOKORO_TTS_URL=http://localhost:8880

# Database
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/neuroadapt
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuroadapt
POSTGRES_DB=neuroadapt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Application Settings
LOG_LEVEL=INFO
GENERATION_CACHE_SIZE=500
CACHE_TTL_SECONDS=300

# Feature Flags
ENABLE_PREFETCH=true
ENABLE_VOICE_CLONING=false
ENABLE_IMAGE_SAFETY_CHECK=false

# Timeouts (seconds)
LATENCY_BUDGET_TEXT_SIMPLIFY=5
LATENCY_BUDGET_ANALOGY=3
LATENCY_BUDGET_AUDIO=3
LATENCY_BUDGET_IMAGE=12
LATENCY_BUDGET_MANIM=45
LATENCY_BUDGET_AVATAR=20

# Redis (optional, for distributed cache)
REDIS_URL=redis://localhost:6379

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Debug
DEBUG=false
PROFILE_PERFORMANCE=false
