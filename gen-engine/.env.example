# gen-engine Environment Configuration (.env.example)
# ===================================================
# Copy to .env and fill in with actual values
# DO NOT commit .env to git

# LLM Provider Selection (dynamic routing)
# If GROQ_API_KEY is not set, runtime automatically falls back to Ollama
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Service URLs
OLLAMA_URL=http://localhost:11434
# Preferred name used by gen-engine runtime
KOKORO_TTS_URL=http://localhost:8880
# Backward-compat alias
TTS_URL=http://localhost:8880

# Application Settings
LOG_LEVEL=INFO
GENERATION_CACHE_SIZE=500
CACHE_TTL_SECONDS=300

# Feature Flags
ENABLE_PREFETCH=true
ENABLE_VOICE_CLONING=false
ENABLE_IMAGE_SAFETY_CHECK=false

# Timeouts (seconds)
LATENCY_BUDGET_TEXT_SIMPLIFY=450
LATENCY_BUDGET_ANALOGY=3
LATENCY_BUDGET_AUDIO=120
LATENCY_BUDGET_IMAGE=60
LATENCY_BUDGET_MANIM=600
LATENCY_BUDGET_AVATAR=20

# Database (optional)
# For local compose postgres, defaults are shown below
POSTGRES_USER=neuroadapt
POSTGRES_PASSWORD=neuroadapt_dev_password
POSTGRES_DB=neuroadapt
DATABASE_URL=postgresql://neuroadapt:neuroadapt_dev_password@localhost:5432/neuroadapt

# Redis (optional, for distributed cache)
REDIS_URL=redis://localhost:6379

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Debug
DEBUG=false
PROFILE_PERFORMANCE=false
