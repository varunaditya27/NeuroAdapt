# Copy this to infra/.env and tune values for your machine/environment.

POSTGRES_USER=neuroadapt
POSTGRES_PASSWORD=neuroadapt_dev_password
POSTGRES_DB=neuroadapt

DATABASE_URL=postgresql://neuroadapt:neuroadapt_dev_password@postgres:5432/neuroadapt
BACKEND_DATABASE_URL=postgresql://neuroadapt:neuroadapt_dev_password@postgres:5432/neuroadapt
GEN_ENGINE_DATABASE_URL=postgresql://neuroadapt:neuroadapt_dev_password@postgres:5432/neuroadapt

REDIS_URL=redis://redis:6379

LOG_LEVEL=INFO

# Optional LLM provider credentials
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b

# Frontend runtime URLs (inside docker network)
NEXT_PUBLIC_BACKEND_URL=http://backend:8000
NEXT_PUBLIC_GEN_ENGINE_URL=http://gen-engine:8001
