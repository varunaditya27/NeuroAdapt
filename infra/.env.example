# Copy this to infra/.env and tune values for your machine/environment.

POSTGRES_USER=neuroadapt
POSTGRES_PASSWORD=neuroadapt_dev_password
POSTGRES_DB=neuroadapt

DATABASE_URL=postgresql+asyncpg://neuroadapt:neuroadapt_dev_password@postgres:5432/neuroadapt
BACKEND_DATABASE_URL=postgresql+asyncpg://neuroadapt:neuroadapt_dev_password@postgres:5432/neuroadapt
GEN_ENGINE_DATABASE_URL=postgresql://neuroadapt:neuroadapt_dev_password@postgres:5432/neuroadapt

LOG_LEVEL=INFO

# Primary cloud LLM provider for the final demo
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional local fallback LLM
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b

# Browser-visible URLs. Keep these localhost/domain values, not Docker hostnames.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_GEN_ENGINE_URL=http://localhost:8001
GEN_ENGINE_PUBLIC_URL=http://localhost:8001
